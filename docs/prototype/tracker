  const v={name:$("name").value.trim(),email:$("email").value.trim(),dept:$("dept").value.trim(),budget:$("budget").value,title:$("title").value.trim(),abs:$("abs").value.trim()};
  if(Object.values(v).some(x=>!x)){$("err").textContent=T("กรุณากรอกข้อมูลที่มี * ให้ครบ");return}
