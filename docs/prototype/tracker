async function advance(id,result){
  const a=apps.find(x=>x.id===id);if(!a)return;
  let step=a.step,res=a.result;
  if(result){step=3;res=result}else step=Math.min(3,a.step+1);
  const note=((document.getElementById("n_"+id)||{}).value||"").trim();
  const log=[...(a.log||[]),{step,at:Date.now(),result:res,...(note?{note}:{})}];
  try{await save(id,{step,result:res,log});delete nd[id]}catch(e){alert(T("อัปเดตไม่สำเร็จ"))}
}
