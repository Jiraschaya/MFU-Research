<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MFU Research · ขอทุนวิจัย</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#faf7f2;--card:#fff;--ink:#2a2420;--mut:#7a6f66;--line:#e6ddd2;--brand:#D2232A;--brand2:#A81B21;--lock:#f5eedd;--gold:#BC9945;--ok:#1f7a4d;--no:#8a1c20;--warn:#9a7420}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17130f;--card:#221c17;--ink:#f1e9df;--mut:#a89c90;--line:#3a3028;--brand:#ef5a60;--brand2:#D2232A;--lock:#2b241d;--gold:#d4b062;--ok:#4cc38a;--no:#ff8a85;--warn:#d4b062}}
:root[data-theme="dark"]{--bg:#17130f;--card:#221c17;--ink:#f1e9df;--mut:#a89c90;--line:#3a3028;--brand:#ef5a60;--brand2:#D2232A;--lock:#2b241d;--gold:#d4b062;--ok:#4cc38a;--no:#ff8a85;--warn:#d4b062}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 "Noto Sans Thai","Sarabun",system-ui,sans-serif}
.wrap{max-width:860px;margin:0 auto;padding:20px 16px 60px}
header{display:flex;align-items:center;gap:12px;margin-bottom:18px;padding-bottom:14px;border-bottom:2px solid var(--gold)}
.logo{width:44px;height:44px;border-radius:12px;background:#D2232A;color:#fff;border-bottom:4px solid #BC9945;display:grid;place-items:center;font-weight:700}
h1{font-size:20px;margin:0}header p{margin:0;color:var(--mut);font-size:13px}
nav{display:flex;gap:6px;background:var(--lock);padding:5px;border-radius:12px;margin-bottom:18px}
nav button{flex:1;border:0;background:none;color:var(--mut);padding:10px;border-radius:9px;font:inherit;font-weight:600;cursor:pointer}
nav button.on{background:var(--card);color:var(--brand);box-shadow:inset 0 -3px 0 var(--gold),0 1px 3px rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.12)}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px;margin-bottom:16px}
.card h2{font-size:16px;margin:0 0 4px;display:flex;align-items:center;gap:8px}
.sub{color:var(--mut);font-size:13px;margin:0 0 14px}
.badge{font-size:12px;padding:2px 9px;border-radius:99px;background:var(--lock);color:var(--mut);font-weight:600;border:1px solid var(--gold)}
.card.locked{border-top:4px solid var(--gold)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
.full{grid-column:1/-1}
label{display:block;font-size:13px;color:var(--mut);margin-bottom:4px;font-weight:600}
input,select,textarea{width:100%;font:inherit;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px}
input:focus,select:focus,textarea:focus{outline:2px solid var(--brand);outline-offset:0}
.locked input,.locked textarea,input:disabled,select:disabled,textarea:disabled{background:var(--lock);color:var(--ink);cursor:not-allowed;opacity:1;border-style:dashed}
.btn{border:0;background:var(--brand);color:#fff;padding:11px 20px;border-radius:10px;font:inherit;font-weight:600;cursor:pointer}
.btn:hover{background:var(--brand2)}.btn.ghost{background:var(--lock);color:var(--ink)}
.btn.ok{background:var(--ok)}.btn.no{background:var(--no)}.btn.sm{padding:6px 12px;font-size:13px}
.btn:disabled{opacity:.5;cursor:not-allowed}
.note{font-size:13px;color:var(--mut)}.err{color:var(--no);font-size:13px;margin-top:8px;min-height:18px}
.live{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--ok);font-weight:600}
.live i{width:8px;height:8px;border-radius:50%;background:var(--ok);animation:p 1.6s infinite}
.live.off{color:var(--warn)}.live.off i{background:var(--warn);animation:none}
@keyframes p{50%{opacity:.3}}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.app h3{margin:0;font-size:16px}.code{font-family:ui-monospace,monospace;font-size:12px;color:var(--mut)}
.steps{display:flex;margin:16px 0 8px;overflow-x:auto;padding-bottom:6px}
.st{flex:1;min-width:84px;text-align:center;position:relative;font-size:12px;color:var(--mut)}
.st::before{content:"";position:absolute;top:13px;left:-50%;width:100%;height:3px;background:var(--line)}
.st:first-child::before{display:none}
.st b{position:relative;z-index:1;display:grid;place-items:center;width:28px;height:28px;border-radius:50%;margin:0 auto 4px;background:var(--line);color:var(--mut);font-size:13px}
.st.done b,.st.cur b{background:var(--brand);color:#fff}.st.done::before,.st.cur::before{background:var(--brand)}
.st.cur{color:var(--ink);font-weight:700}.st.cur b{box-shadow:0 0 0 4px color-mix(in srgb,var(--brand) 25%,transparent)}
.st.ok b{background:var(--ok)}.st.no b{background:var(--no)}
.tag{display:inline-block;padding:2px 10px;border-radius:99px;font-size:12px;font-weight:700;color:#fff;background:var(--brand)}
.tag.ok{background:var(--ok)}.tag.no{background:var(--no)}
.log{margin:10px 0 0;padding:0;list-style:none;font-size:13px;color:var(--mut)}
.log li{padding:3px 0}
.empty{text-align:center;color:var(--mut);padding:30px 0}
.search{display:flex;gap:8px;margin-bottom:14px}
.hide{display:none}

.app{display:flex;min-height:100vh}
.side{width:268px;flex:none;background:var(--card);border-right:1px solid var(--line);display:flex;flex-direction:column;padding:18px 14px;position:sticky;top:0;height:100vh;transition:margin .2s}
.side.collapsed{margin-left:-268px}
.brand{display:flex;align-items:center;gap:10px;padding:2px 6px 16px;border-bottom:1px solid var(--line)}
.logo2{width:46px;height:46px;border-radius:50%;background:#D2232A;border:3px solid #BC9945;color:#fff;display:grid;place-items:center;font-weight:800;font-size:18px}
.brand b{display:block;color:var(--brand);font-size:18px;letter-spacing:.3px;line-height:1.2}.brand small{color:var(--gold);font-weight:600;font-size:12px}
.menu-l{font-size:12px;color:var(--mut);font-weight:700;margin:18px 8px 8px;letter-spacing:.5px}
.menu{display:flex;flex-direction:column;gap:6px}
.menu button{display:flex;align-items:center;gap:12px;border:0;background:none;color:var(--ink);font:inherit;font-weight:600;padding:12px 14px;border-radius:12px;cursor:pointer;text-align:left}
.menu button:hover{background:var(--lock)}.menu button.on{background:var(--brand);color:#fff}
.ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
.help{margin-top:auto;background:var(--lock);border-radius:12px;padding:14px;font-size:13px;display:flex;flex-direction:column;gap:2px}
.help span{color:var(--mut)}
.main{flex:1;min-width:0;display:flex;flex-direction:column}
.top{display:flex;align-items:center;gap:10px;background:var(--card);border-bottom:1px solid var(--line);padding:12px 20px;position:sticky;top:0;z-index:5}
.ttl b{display:block;line-height:1.2}.ttl small,.chip small{display:block;color:var(--mut);font-size:12px;line-height:1.2}.sp{flex:1}
.icb{position:relative;border:0;background:none;color:var(--ink);padding:8px;border-radius:10px;cursor:pointer;display:grid;place-items:center}.icb:hover{background:var(--lock)}
.dot{position:absolute;top:6px;right:6px;width:9px;height:9px;border-radius:50%;background:var(--brand);border:2px solid var(--card)}
.chip{display:flex;align-items:center;gap:10px;padding-left:12px;border-left:1px solid var(--line)}.chip b{font-size:14px;display:block;line-height:1.2}
.av{width:38px;height:38px;border-radius:50%;background:color-mix(in srgb,var(--brand) 14%,var(--card));color:var(--brand);display:grid;place-items:center;font-weight:700}
.content{padding:22px;max-width:1040px;width:100%;margin:0 auto}
.pg{display:none}.pg.on{display:block}
.pt{margin:0;font-size:20px}
.hero{display:flex;justify-content:space-between;align-items:center;color:#fff;border-radius:18px;padding:30px 34px;background:linear-gradient(90deg,var(--brand) 0 76%,var(--brand2) 76%);margin-bottom:16px;box-shadow:0 6px 18px color-mix(in srgb,var(--brand) 28%,transparent)}
.hero small{opacity:.85}.hero h2{margin:2px 0 6px;font-size:30px;line-height:1.2}.hero p{margin:0;opacity:.9;font-size:14px;max-width:520px}
.ring{width:84px;height:84px;border-radius:50%;border:2px solid var(--gold);background:rgba(255,255,255,.12);display:grid;place-items:center;color:var(--gold)}.ring .ic{width:36px;height:36px}
.heroic{padding:0 10px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
.stat{background:var(--card);border:1px solid var(--line);border-top:3px solid var(--gold);border-radius:14px;padding:14px 16px}
.stat b{display:block;font-size:28px;line-height:1.2;color:var(--brand)}.stat span{color:var(--mut);font-size:13px}
.stat.ok b{color:var(--ok)}.stat.no b{color:var(--no)}
.ann{display:grid;grid-template-columns:1fr 240px;background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden;margin-bottom:16px}
.annT{padding:26px 28px}.annT h3{margin:6px 0;font-size:22px;line-height:1.3}.annT p{color:var(--mut);margin:0 0 16px}
.eyebrow{font-size:12px;font-weight:700;color:var(--gold);letter-spacing:.5px}.d{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--brand);margin-right:6px}
.annArt{background:var(--brand);display:grid;place-items:center}
.mini{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:11px 0;border-top:1px solid var(--line);cursor:pointer}
.mini:first-child{border-top:0}.mini b{display:block}.mini:hover b{color:var(--brand)}
.bd{display:none}
@media(max-width:860px){
 .side{position:fixed;z-index:20;left:0;top:0;transform:translateX(-100%);transition:transform .2s;margin:0!important}
 .side.open{transform:none;box-shadow:0 0 40px rgba(0,0,0,.35)}
 .bd.show{display:block;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:15}
 .stats{grid-template-columns:1fr 1fr}.ann{grid-template-columns:1fr}.annArt{display:none}
 .hero{padding:22px;background:var(--brand)}.heroic{display:none}.hero h2{font-size:24px}
 .chip div:last-child{display:none}.chip{padding-left:4px}.content{padding:14px}
}

.bar{height:8px;background:var(--line);border-radius:99px;overflow:hidden;margin:12px 0 4px}
.bar i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),var(--brand));border-radius:99px;transition:width .6s}.bar i.no{background:var(--no)}
.pl{font-size:12px;color:var(--mut)}
.st em{display:block;font-style:normal;font-size:11px;color:var(--mut);min-height:16px}
.now{background:var(--lock);border-left:4px solid var(--gold);border-radius:8px;padding:10px 12px;font-size:14px;margin:8px 0}
.pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:8px 0 14px}
.pt2{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:12px;padding:10px 6px;font:inherit;cursor:pointer;text-align:center}
.pt2 b{display:block;font-size:22px;color:var(--mut);line-height:1.3}.pt2.has b{color:var(--brand)}.pt2 span{font-size:12px;color:var(--mut)}
.pt2.on{border-color:var(--brand);box-shadow:inset 0 -3px 0 var(--gold);background:color-mix(in srgb,var(--brand) 8%,var(--card))}
.ev{display:flex;gap:12px;padding:9px 0;border-top:1px solid var(--line)}.ev:first-of-type{border-top:0}
.ev>i{width:10px;height:10px;border-radius:50%;background:var(--brand);margin-top:7px;flex:none;box-shadow:0 0 0 4px color-mix(in srgb,var(--brand) 18%,transparent)}
.ev b{display:block;line-height:1.3}.ev span{font-size:12px;color:var(--mut)}
.toast{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));background:var(--ink);color:var(--bg);padding:12px 16px;border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.3);z-index:50;max-width:320px;font-size:14px}
@media(max-width:600px){.pipe{overflow-x:auto;grid-template-columns:repeat(4,minmax(78px,1fr))}}
.ctl{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:10px 0}.ctl .noteIn{flex:1;min-width:160px;padding:7px 10px;font-size:14px}
details{margin-top:8px}summary{cursor:pointer;color:var(--mut);font-size:13px}
</style>
</head>
<body>
<div class="app">
<aside id="side" class="side">
 <div class="brand"><div class="logo2">R</div><div><b>MFU RESEARCH</b><small>ระบบบริหารจัดการทุนวิจัย มหาวิทยาลัยแม่ฟ้าหลวง</small></div></div>
 <div class="menu-l">เมนูสำหรับนักวิจัย</div>
 <div class="menu">
  <button data-pg="home" class="on"><svg class="ic" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg><span>หน้าหลัก</span></button>
  <button data-pg="mine"><svg class="ic" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 17h6"/></svg><span>โครงการของฉัน</span></button>
  <button data-pg="profile"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg><span>โปรไฟล์นักวิจัย</span></button>
  <button data-pg="new"><svg class="ic" viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6z"/><path d="M9 13h6M9 17h6"/></svg><span>ยื่นข้อเสนอใหม่</span></button>
 </div>
 <div class="help"><b>ต้องการความช่วยเหลือ?</b><span>ติดต่อส่วนบริหารงานวิจัย มหาวิทยาลัยแม่ฟ้าหลวง</span><span>โทร. 0-5391-6387</span></div>
</aside>
<div class="bd" id="bd"></div>
<div class="main">
 <div class="top">
  <button class="icb" id="burger" aria-label="menu"><svg class="ic" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  <div class="ttl"><b>MFU RESEARCH</b><small>ระบบบริหารจัดการทุนวิจัย มหาวิทยาลัยแม่ฟ้าหลวง</small></div>
  <div class="sp"></div>
  <button class="btn ghost sm" id="lang" aria-label="Language">EN</button>
  <button class="icb" id="bell" aria-label="notifications"><svg class="ic" viewBox="0 0 24 24"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4z"/><path d="M10 21h4"/></svg><i class="dot hide" id="dot"></i></button>
  <div class="chip"><div class="av" id="av">R</div><div><b id="uName">—</b><small id="uRole">นักวิจัย</small></div></div>
 </div>
 <div class="content">

 <section id="pg-home" class="pg on">
  <div class="hero"><div><small>ยินดีต้อนรับเข้าสู่ระบบ</small><h2>พื้นที่สำหรับนักวิจัย</h2><p>ยื่นข้อเสนอโครงการ ติดตามสถานะ และจัดการข้อมูลของคุณได้อย่างสะดวกในที่เดียว</p></div><div class="heroic"><div class="ring"><svg class="ic" viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 17h6"/></svg></div></div></div>
  <div class="stats">
   <div class="stat"><b id="sTotal">0</b><span>โครงการทั้งหมด</span></div>
   <div class="stat"><b id="sProg">0</b><span>กำลังพิจารณา</span></div>
   <div class="stat ok"><b id="sOk">0</b><span>อนุมัติ</span></div>
   <div class="stat no"><b id="sNo">0</b><span>ไม่อนุมัติ</span></div>
  </div>
  <div class="card" id="spot"></div>
  <div class="card"><h2>ความเคลื่อนไหวล่าสุด</h2><div id="recent"></div></div>
  <div id="annBox"></div>
 </section>

 <section id="pg-mine" class="pg">
  <div class="row" style="margin-bottom:6px"><div><h2 class="pt">โครงการของฉัน</h2><p class="sub" style="margin:0">ติดตามสถานะโครงการแบบเรียลไทม์</p></div><button class="btn sm addBtn">+ เพิ่มงานวิจัย</button></div>
  <div class="row" style="margin:10px 0"><span class="live" id="live"><i></i><span>เรียลไทม์</span></span><span class="note" id="who"></span></div>
  <div class="pipe" id="pipe"></div>
  <div class="search"><input id="q" placeholder="ค้นหาด้วยรหัสติดตาม / ชื่อผู้ยื่น / ชื่อโครงการ"></div>
  <div id="list"></div>
 </section>

 <section id="pg-profile" class="pg">
  <div class="card"><h2>ข้อมูลนักวิจัย</h2><p class="sub">ข้อมูลนี้จะถูกใช้กรอกฟอร์มให้อัตโนมัติ และเก็บไว้ในเบราว์เซอร์ของคุณเท่านั้น</p>
   <div class="grid">
    <div><label>ชื่อ-นามสกุล</label><input id="pName"></div>
    <div><label>อีเมลมหาวิทยาลัย</label><input id="pEmail" type="email"></div>
    <div class="full"><label>สำนักวิชา / หน่วยงาน</label><input id="pDept"></div>
   </div>
   <div class="row" style="margin-top:12px"><span class="note" id="pMsg"></span><button class="btn" id="pSave">บันทึกโปรไฟล์</button></div>
  </div>
 </section>

 <section id="pg-new" class="pg">
  <div class="card locked">
    <h2>ส่วนที่ 1 · รายละเอียดทุน <span class="badge">🔒 ล็อก แก้ไขไม่ได้</span></h2>
    <p class="sub">ข้อมูลส่วนนี้กำหนดโดยหน่วยงาน ผู้ยื่นคำขอไม่สามารถแก้ไขได้</p>
    <div class="grid" id="lockedGrid"></div>
  </div>
  <div class="card">
    <h2>ส่วนที่ 2 · ข้อมูลผู้ยื่นและโครงการ <span class="badge" id="b2">กรอกได้</span></h2>
    <p class="sub">เมื่อกดยื่นคำขอแล้ว ฟอร์มทั้งหมดจะถูกล็อกทันที</p>
    <div class="grid" id="f2">
      <div><label>ชื่อ-นามสกุล *</label><input id="name" placeholder="ผศ.ดร. ..."></div>
      <div><label>อีเมลมหาวิทยาลัย *</label><input id="email" type="email" placeholder="name@mfu.ac.th"></div>
      <div><label>สำนักวิชา / หน่วยงาน *</label><input id="dept"></div>
      <div><label>งบประมาณที่ขอ (บาท) *</label><input id="budget" type="number" min="0"></div>
      <div class="full"><label>ชื่อโครงการวิจัย *</label><input id="title"></div>
      <div class="full"><label>บทคัดย่อโครงการ *</label><textarea id="abs" rows="5"></textarea></div>
    </div>
    <div class="err" id="err"></div>
    <div class="row" style="margin-top:8px"><span class="note" id="hint"></span><span><button class="btn ghost hide addBtn" id="addNew">+ เพิ่มงานวิจัย</button> <button class="btn" id="submit">ยื่นคำขอทุน</button></span></div>
  </div>
</section>

 </div>
</div></div>

<div class="toast hide" id="toast"></div>
<script>
// ===== ส่วนที่ล็อก: แก้ค่าตรงนี้ก่อนเผยแพร่ =====
const LOCKED=[
 ["ชื่อทุน","ทุนสนับสนุนงานวิจัย MFU Research"],
 ["หน่วยงานเจ้าของทุน","มหาวิทยาลัยแม่ฟ้าหลวง"],
 ["กลุ่มผู้มีสิทธิ์ยื่น","นักวิจัย(หัวหน้าโครงการ)"],
 ["วงเงินสูงสุดต่อโครงการ","300,000 บาท"],
