function walk(){
  const w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT);const ns=[];
  while(w.nextNode())ns.push(w.currentNode);
  ns.forEach(n=>{const pe=n.parentElement;if(!pe||pe.closest("script,textarea,#list,#recent,#spot,#pipe,#toast,#annBox"))return;
    const t=n.nodeValue.trim();if(!t)return;const base=TH[t]||t;
    if(EN[base]||TH[t])n.nodeValue=n.nodeValue.replace(t,lang==="en"?EN[base]:base)});
  document.querySelectorAll("[placeholder]").forEach(e=>{const t=e.placeholder,base=TH[t]||t;if(EN[base])e.placeholder=lang==="en"?EN[base]:base});
  document.title=T("MFU Research · ขอทุนวิจัย");document.documentElement.lang=lang;$("lang").textContent=lang==="en"?"TH":"EN";
}
function setLang(l){lang=l;walk();renderLocked();render();setChip()}
