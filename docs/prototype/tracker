  render();
}
function setLive(on){if(!db)return;$("live").classList.toggle("off",!on);$("live").lastChild.textContent=T(on?"เรียลไทม์ · อัปเดตอัตโนมัติ":"การเชื่อมต่อขัดข้อง")}
async function save(id,data,isNew){
  if(db){isNew?await coll.doc(id).set(data):await coll.doc(id).update(data)}
  else{const i=apps.findIndex(a=>a.id===id);i<0?apps.unshift({id,...data}):Object.assign(apps[i],data);render()}
}

