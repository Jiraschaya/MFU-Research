    let ctl="";
    if(isAdmin&&a.step<3){
      const inp=`<input class="noteIn" id="n_${a.id}" placeholder="${T("หมายเหตุ (ไม่บังคับ)")}" value="${esc(nd[a.id]||"")}" oninput="nd['${a.id}']=this.value" onblur="render()">`;
      ctl=inp+(a.step===2?`<button class="btn ok sm" onclick="adv('${a.id}','approved')">${T("อนุมัติ")}</button> <button class="btn no sm" onclick="adv('${a.id}','rejected')">${T("ไม่อนุมัติ")}</button>`
        :`<button class="btn sm" onclick="adv('${a.id}')">${T("เลื่อนไป:")} ${T(STEPS[a.step+1])} →</button>`)}
    const log=(a.log||[]).slice().reverse().map(l=>`<li>• ${fmt(l.at)} — ${stL(l.step,l.result)}${l.note?" · "+esc(l.note):""}</li>`).join("");
    return `<div class="card app"><div class="row"><div><h3>${esc(a.title)}</h3><div class="code">${a.id} · ${esc(a.name)} · ${esc(a.dept)} · ${(+a.budget).toLocaleString()} ${T("บาท")}</div></div>${tagOf(a)}</div>
    ${upd(a)}${stepper(a)}${noteBox(a)}${ctl?`<div class="ctl">${ctl}</div>`:""}
    <details><summary>${T("ประวัติการอัปเดต")}</summary><ul class="log">${log}</ul></details></div>`}).join("");
}
$("q").oninput=render;
// ===== shell: navigation, home, profile =====
const norm=a=>({...a,step:Math.min(a.step||0,3),log:(a.log||[]).map(l=>({...l,step:Math.min(l.step,3)}))});
const vis=a=>isAdmin||!myId||a.owner===myId;
let profile={name:"",email:"",dept:""};
try{Object.assign(profile,JSON.parse(localStorage.getItem("mfu_profile")||"{}"))}catch(e){}
function fillForm(){if(submitted)return;[["name","name"],["email","email"],["dept","dept"]].forEach(([i,k])=>{if(!$(i).value)$(i).value=profile[k]||""})}
$("pName").value=profile.name||"";$("pEmail").value=profile.email||"";$("pDept").value=profile.dept||"";fillForm();
$("pSave").onclick=()=>{profile={name:$("pName").value.trim(),email:$("pEmail").value.trim(),dept:$("pDept").value.trim()};
  try{localStorage.setItem("mfu_profile",JSON.stringify(profile))}catch(e){}
  if(!submitted){["name","email","dept"].forEach(k=>$(k).value=profile[k])}
  setChip();$("pMsg").textContent=T("บันทึกแล้ว ✓")};
function setChip(){$("uName").textContent=profile.name||"—";$("av").textContent=(profile.name||"R").trim().charAt(0).toUpperCase();
  $("uRole").textContent=T(isAdmin?"ผู้ดูแล":"นักวิจัย");
  
  $("who").textContent=T(isAdmin?"สิทธิ์: ผู้ดูแล — เลื่อนสถานะได้":"สิทธิ์: นักวิจัย — ตรวจสอบสถานะได้");
  $("dot").classList.toggle("hide",!apps.some(a=>vis(a)&&a.step>=3))}
function go(pg){
  document.querySelectorAll(".pg").forEach(e=>e.classList.toggle("on",e.id==="pg-"+pg));
  document.querySelectorAll(".menu button").forEach(b=>b.classList.toggle("on",b.dataset.pg===pg));
  $("side").classList.remove("open");$("bd").classList.remove("show");scrollTo({top:0});
}
document.querySelectorAll("[data-pg]").forEach(b=>b.onclick=()=>go(b.dataset.pg));
document.querySelectorAll("[data-go]").forEach(b=>b.onclick=()=>go(b.dataset.go));
$("bell").onclick=()=>go("mine");
$("burger").onclick=()=>{if(innerWidth<=860){$("side").classList.toggle("open");$("bd").classList.toggle("show")}else $("side").classList.toggle("collapsed")};
$("bd").onclick=()=>{$("side").classList.remove("open");$("bd").classList.remove("show")};
function renderHome(){
  const m=apps.filter(vis);
  $("sTotal").textContent=m.length;$("sProg").textContent=m.filter(a=>a.step<3).length;
  $("sOk").textContent=m.filter(a=>a.step>=3&&!rejd(a)).length;$("sNo").textContent=m.filter(rejd).length;
  const r=m.slice().sort((a,b)=>lastAt(b)-lastAt(a)),a0=r[0];
  $("spot").innerHTML=a0?`<div class="row"><h2 style="margin:0">${T("ติดตามโครงการล่าสุด")}</h2><button class="btn ghost sm" onclick="$('q').value='${a0.id}';go('mine');render()">${T("ดูรายละเอียด")}</button></div>
   <div class="row" style="margin-top:10px"><div><h3 style="margin:0">${esc(a0.title)}</h3><span class="code">${a0.id}</span></div>${tagOf(a0)}</div>${upd(a0)}${stepper(a0)}${noteBox(a0)}`
   :`<div class="empty">${T("ยังไม่มีโครงการ")}<br><button class="btn sm" style="margin-top:10px" onclick="go('new')">${T("ยื่นข้อเสนอ →")}</button></div>`;
  const ev=[];m.forEach(a=>(a.log||[]).forEach(l=>ev.push({a,l})));ev.sort((x,y)=>y.l.at-x.l.at);
  $("recent").innerHTML=ev.length?ev.slice(0,6).map(({a,l})=>`<div class="ev"><i></i><div><b>${esc(a.title)}</b><span>${stL(l.step,l.result)} · ${fmt(l.at)}</span></div></div>`).join(""):`<div class="note" style="padding:8px 0">${T("ยังไม่มีความเคลื่อนไหว")}</div>`;
  setChip();if(!annEdit)renderAnn();
}

let _c=[];document.querySelector(".logo2").onclick=()=>{const n=Date.now();_c=_c.filter(t=>n-t<1200);_c.push(n);
  if(_c.length>=3&&canAdmin){_c=[];adminMode=!adminMode;isAdmin=canAdmin&&adminMode;annEdit=false;render();toast(isAdmin?"Admin mode":"Lecturer mode")}};
connect();
</script>
</body>
