async function connect(){
  try{
    if(!window.claude)throw 0;
    db=await claude.use("db");user=await claude.use("user");
    if(!db)throw 0;
    canAdmin=!!(user&&user.canEdit());isAdmin=false;
    try{myId=user&&user.id?await user.id():null}catch(e){}
    coll=db.collection("grant_apps");
    db.collection("settings").onSnapshot(sn=>{const d=sn.docs.find(x=>x.id==="announcement");ann=d?d.data():null;if(!annEdit)renderAnn()},()=>{});
    coll.onSnapshot(s=>{apps=s.docs.map(d=>norm({id:d.id,...d.data()}));setLive(true);notify();render()},()=>setLive(false));
  }catch(e){db=null;setLive(false);$("live").lastChild.textContent=T("โหมดออฟไลน์ (ข้อมูลไม่ถูกแชร์)");canAdmin=true;isAdmin=false}
